         elseif(typename(7:12).eq.'FORCED') then
           elname='VOFO   '
           ndprop=10
+        else
+          write(*,*) '*ERROR reading *FLUID SECTION: ',typename
+          write(*,*) '       is an unknown fluid section type'
+          ier=1
+          return
         endif
 !     
       elseif(typename(1:1).eq.' ') then
         elname='       '
         ndprop=0
