 !     
       do i=2,n
         if(textpart(i)(1:9).eq.'MATERIAL=') then
@@ -486,6 +488,11 @@ C     ndprop=20
           elname='RCVL   '
         else if(typename(15:23).eq.'NONLINEAR')then
           elname='RCVN   '
