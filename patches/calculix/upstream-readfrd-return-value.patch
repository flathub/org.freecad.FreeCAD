+       bogus out-of-memory error.  Fail here instead. */
+
+    if(readfrd( datin, anz, &node, &elem, &lcase, read_mode)<0){
+	printf(" *ERROR in getglobalresults: the frd-file \"%s\"\n        could not be read\n",datin);
+	FORTRAN(stop,());
+    }
     
