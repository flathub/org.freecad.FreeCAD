@@ -758,7 +759,7 @@ for ( ip = heads[J], heads[J] = NULL ;
               I, frontIsDone[I], I, p_mtx[I]) ;
       fflush(msgFile) ;
    }
-   if ( frontIsDone[I] == 'Y' ) {
+   if ( SPOOLES_LOAD_ACQUIRE(&frontIsDone[I]) == 'Y' ) {
       if ( (YI = p_mtx[I]) != NULL ) {
 /*
          --------------------------------
@@ -930,7 +931,7 @@ for ( ip = heads[J], heads[J] = NULL ;
               "\n\n frontIsDone[%d] = %c", K, frontIsDone[K]) ;
       fflush(msgFile) ;
    }
-   if ( frontIsDone[K] == 'Y' ) {
+   if ( SPOOLES_LOAD_ACQUIRE(&frontIsDone[K]) == 'Y' ) {
       if ( (XK = p_mtx[K]) != NULL ) {
 /*
          --------------------------------
