    list->nlocks++ ;
    Lock_unlock(list->lock) ;
@@ -117,11 +119,12 @@ if ( list->lock != NULL
    ---------------------------------------------
 */
    if ( mtx != NULL ) {
-      mtx->next = list->heads[ilist] ;
-      list->heads[ilist] = mtx ;
+      mtx->next = SPOOLES_LOAD_ACQUIRE(&list->heads[ilist]) ;
+      SPOOLES_STORE_RELEASE(&list->heads[ilist], mtx) ;
    }
    if ( list->counts != NULL ) {
-      list->counts[ilist]-- ;
+      SPOOLES_STORE_RELEASE(&list->counts[ilist],
+                            SPOOLES_LOAD_RELAXED(&list->counts[ilist]) - 1) ;
    }
 }
 #if MYDEBUG > 0
@@ -162,17 +165,18 @@ if ( list == NULL || ilist < 0 || ilist >= list->nlist ) {
 fprintf(stdout, "\n SubMtxList %p : get list %d", list, ilist) ;
 fflush(stdout) ;
 #endif
-if ( list->heads[ilist] != NULL ) {
+if ( SPOOLES_LOAD_ACQUIRE(&list->heads[ilist]) != NULL ) {
    if ( list->lock == NULL
      || (list->flags != NULL && list->flags[ilist] == 'N')
-     || (list->counts != NULL && list->counts[ilist] == 0) ) {
+     || (list->counts != NULL
+        && SPOOLES_LOAD_ACQUIRE(&list->counts[ilist]) == 0) ) {
 /*
       ------------------------
       no need to lock the list
       ------------------------
 */
-      mtx = list->heads[ilist] ;
-      list->heads[ilist] = NULL ;
+      mtx = SPOOLES_LOAD_ACQUIRE(&list->heads[ilist]) ;
+      SPOOLES_STORE_RELAXED(&list->heads[ilist], (SubMtx *) NULL) ;
    } else {
 /*
       ----------------------------------------------------
@@ -180,8 +184,8 @@ if ( list->heads[ilist] != NULL ) {
       ----------------------------------------------------
 */
       Lock_lock(list->lock) ;
-      mtx = list->heads[ilist] ;
-      list->heads[ilist] = NULL ;
+      mtx = SPOOLES_LOAD_ACQUIRE(&list->heads[ilist]) ;
+      SPOOLES_STORE_RELAXED(&list->heads[ilist], (SubMtx *) NULL) ;
       list->nlocks++ ;
       Lock_unlock(list->lock) ;
    }
diff --git a/Utilities/SPOOLESatomic.h b/Utilities/SPOOLESatomic.h
new file mode 100644
index 0000000..8fe393c
--- /dev/null
+++ b/Utilities/SPOOLESatomic.h
@@ -0,0 +1,97 @@
+/*  SPOOLESatomic.h  */
+
+#ifndef _SPOOLES_ATOMIC_
+#define _SPOOLES_ATOMIC_
+
+/*
+   --------------------------------------------------------------------
+   Acquire/release helpers for the multithreaded (MT) solvers.
+
+   The MT factorization and solve hand data between threads through
+   plain, unqualified memory: the ChvList/SubMtxList heads[] and
+   counts[] vectors, the frontIsDone[]/p_mtx[] pair in the solve, and
+   the lowerIsDone[]/diagIsDone[]/upperIsDone[] barriers.  In every case
+   a producer writes a payload and then publishes a flag or pointer, and
+   a consumer tests the flag and then reads the payload -- with no
+   synchronization between the two.
+
+   On a total-store-ordered machine (x86, x86_64, SPARC TSO) the
+   producer's stores reach memory in program order and the consumer's
+   loads are not reordered, so observing the flag implies observing the
+   payload and the code happens to be correct.  On a weakly ordered
+   machine (aarch64, armhf, ppc64el, riscv64, loong64) nothing orders
+   them and a consumer can act on a payload it cannot yet see.
+
+   These macros put a release store on each publication and an acquire
+   load on each consumption, which is exactly the missing edge.  They
+   deliberately operate on the *existing*, unqualified struct fields
+   rather than introducing _Atomic-qualified members, so that struct
+   layouts, sizes and the library ABI are unchanged and this is a
+   drop-in patch for an already-shipped shared library.
+
+   Cost: on x86 an acquire load and a release store are ordinary MOVs,
+   so TSO targets are unaffected.  On aarch64 they become LDAR/STLR on
+   flag and pointer words only -- not in any inner numerical loop.
+
+   created -- 2026sep07
+   --------------------------------------------------------------------
+*/
+
+#if defined(__ATOMIC_ACQUIRE) && defined(__ATOMIC_RELEASE)
+/*
+   GCC 4.7+, Clang 3.1+, ICC, and any compiler providing the __atomic
+   builtins.  Applying these to a non-_Atomic lvalue is supported and
+   generates the plain load/store plus the required barrier.
+*/
+#define SPOOLES_LOAD_ACQUIRE(ptr)       __atomic_load_n((ptr), __ATOMIC_ACQUIRE)
+#define SPOOLES_STORE_RELEASE(ptr, val) __atomic_store_n((ptr), (val), __ATOMIC_RELEASE)
+#define SPOOLES_LOAD_RELAXED(ptr)       __atomic_load_n((ptr), __ATOMIC_RELAXED)
+#define SPOOLES_STORE_RELAXED(ptr, val) __atomic_store_n((ptr), (val), __ATOMIC_RELAXED)
+#define SPOOLES_FETCH_ADD_RELAXED(ptr, val) \
+           __atomic_fetch_add((ptr), (val), __ATOMIC_RELAXED)
+#define SPOOLES_HAVE_ATOMICS 1
+
+#elif defined(__GNUC__) && (__GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 1))
+/*
+   Older GCC: the legacy __sync builtins only give us a full barrier,
+   which is stronger than needed but correct.  volatile keeps the
+   compiler from caching the flag across a spin loop.
+*/
+#define SPOOLES_LOAD_ACQUIRE(ptr)                                       \
+           ({ __typeof__(*(ptr)) _v = *(volatile __typeof__(*(ptr)) *)(ptr) ; \
+              __sync_synchronize() ; _v ; })
+#define SPOOLES_STORE_RELEASE(ptr, val)                                 \
+           do { __sync_synchronize() ;                                  \
+                *(volatile __typeof__(*(ptr)) *)(ptr) = (val) ; } while (0)
+#define SPOOLES_LOAD_RELAXED(ptr)       (*(volatile __typeof__(*(ptr)) *)(ptr))
+#define SPOOLES_STORE_RELAXED(ptr, val) \
+           do { *(volatile __typeof__(*(ptr)) *)(ptr) = (val) ; } while (0)
+#define SPOOLES_FETCH_ADD_RELAXED(ptr, val) __sync_fetch_and_add((ptr), (val))
+#define SPOOLES_HAVE_ATOMICS 1
+
+#else
+/*
+   No atomic builtins.  Fall back to plain accesses, which is what SPOOLES
+   2.2 has always done.  This is correct only on a total-store-ordered
+   machine; warn so that a weakly ordered port does not silently inherit
+   the original bug.
+
+   Note that __typeof__ is a GNU extension, so it cannot be used here --
+   this branch exists precisely for compilers that are not GCC-like.  The
+   spin loops in FrontMtx_workerSolve() are therefore not protected from
+   being hoisted; a compiler reaching this branch needs its own equivalent
+   of volatile there.
+*/
+#if defined(__aarch64__) || defined(__arm__) || defined(__powerpc__) \
+ || defined(__powerpc64__) || defined(__riscv) || defined(__loongarch__)
+#error "SPOOLES MT: no atomic builtins on a weakly ordered target.  The MT solvers return silently wrong results without them -- see Utilities/SPOOLESatomic.h.  Build without the MT library, or add acquire/release primitives for this compiler."
+#endif
+#define SPOOLES_LOAD_ACQUIRE(ptr)       (*(ptr))
+#define SPOOLES_STORE_RELEASE(ptr, val) do { *(ptr) = (val) ; } while (0)
+#define SPOOLES_LOAD_RELAXED(ptr)       (*(ptr))
+#define SPOOLES_STORE_RELAXED(ptr, val) do { *(ptr) = (val) ; } while (0)
+#define SPOOLES_FETCH_ADD_RELAXED(ptr, val) (*(ptr) += (val))
+#define SPOOLES_HAVE_ATOMICS 0
+#endif
+
+#endif /* _SPOOLES_ATOMIC_ */
