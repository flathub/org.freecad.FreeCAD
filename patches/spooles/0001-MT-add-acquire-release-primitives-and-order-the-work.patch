From cb806200085ebfa1ecf2b6018608ad65e49e299c Mon Sep 17 00:00:00 2001
From: Jacob Oursland <jacob.oursland@gmail.com>
Date: Mon, 7 Sep 2026 17:26:48 -0600
Subject: [PATCH] MT: add acquire/release primitives and order the work-list
 handoff

This is the defect that corrupts the factorization.

ChvList_addObjectToList() pushes the object onto heads[ilist] and then
decrements counts[ilist], both under the list's mutex.  The consumer,
FrontMtx_factorVisit(), reads both *without* the mutex:

    if ( ChvList_isListNonempty(aggList, J) == 1 )
       assembleAggregates(...) ;
    if ( ChvList_isCountZero(aggList, J) == 1 ) {
       if ( ChvList_isListNonempty(aggList, J) == 1 )
          assembleAggregates(...) ;
       allAggregatesHere = 'Y' ;      /* front is now factored */
    }

ChvList_isCountZero() and ChvList_isListNonempty() take no lock at all,
and ChvList_getList() has an explicit unlocked fast path once the count
reaches zero.  So a thread can observe counts[J] == 0 -- "every other
thread has contributed" -- while heads[J] still reads NULL, conclude
that no aggregates are pending, and factor front J without a
Schur-complement update that another thread has in fact already
produced.  The result is silently wrong by O(1), not a crash.

On a total-store-ordered machine (x86, x86_64, SPARC TSO) the
producer's stores reach memory in program order and the consumer's
loads are not reordered, so the code mostly gets away with it.  On a
weakly ordered machine (aarch64, armhf, ppc64el, riscv64, loong64)
nothing orders them at all.  "Mostly" is doing real work in that
sentence: the same reproducer still fails 8 runs in 2000 on x86_64.

Add Utilities/SPOOLESatomic.h, a small set of acquire/release
primitives over the __atomic builtins (with a __sync fallback for GCC
before 4.7), and use them here: the heads[] store becomes a release
store, the counts[] store a release store sequenced after it, and every
consumer-side read of either an acquire load.  Observing counts[J]==0
now implies observing heads[J] and everything the producer wrote into
the object it published.

The primitives deliberately operate on the *existing*, unqualified
struct fields rather than introducing _Atomic-qualified members, so
struct layouts, sizes and the library ABI are unchanged and this is safe
to apply to an already-shipped shared library.  Every access is to a
naturally aligned int, char or pointer, so they all inline -- no
libatomic dependency.  On x86 an acquire load and a release store are
ordinary MOVs; on aarch64 they become LDAPR/STLR on flag and pointer
words only, never inside a numerical loop.

The unlocked paths are ordered too, not just the locked ones -- the
lock-free path is taken precisely when the count says the producers are
finished, which is the case that was broken.

Verified: this and the following two patches together take SPOOLES' own
MT/drivers/testGridMT from 66/400 wrong at 20^3 on 4 threads (aarch64,
Apple M-series, clang -O2) to 0/2000, and remove all 19 Chv_assembleChv
and 6 real_updDenseColumns races ThreadSanitizer reported -- those were
consequences of this missing edge, not separate defects.
---
 ChvList/src/util.c        | 32 +++++++------
 SubMtxList/src/util.c     | 32 +++++++------
 Utilities/SPOOLESatomic.h | 97 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 133 insertions(+), 28 deletions(-)
 create mode 100644 Utilities/SPOOLESatomic.h

diff --git a/ChvList/src/util.c b/ChvList/src/util.c
index 33c752e..ea4d8dd 100644
--- a/ChvList/src/util.c
+++ b/ChvList/src/util.c
@@ -1,6 +1,7 @@
 /*  util.c  */
 
 #include "../ChvList.h"
+#include "../../Utilities/SPOOLESatomic.h"
 
 #define MYDEBUG 0
 
@@ -27,7 +28,7 @@ if ( chvlist == NULL || ilist < 0 || ilist >= chvlist->nlist ) {
    fprintf(stderr, "\n fatal error in ChvList_isListNonempty(%p,%d)"
            "\n bad input\n", chvlist, ilist) ;
 }
-return(chvlist->heads[ilist] != NULL) ; }
+return(SPOOLES_LOAD_ACQUIRE(&chvlist->heads[ilist]) != NULL) ; }
 
 /*--------------------------------------------------------------------*/
 /*
@@ -55,7 +56,7 @@ if ( chvlist == NULL || ilist < 0 || ilist >= chvlist->nlist ) {
 if ( chvlist->counts == NULL ) {
    return(1) ;
 } else {
-   return(chvlist->counts[ilist] == 0) ;
+   return(SPOOLES_LOAD_ACQUIRE(&chvlist->counts[ilist]) == 0) ;
 }
 }
 
@@ -102,11 +103,12 @@ if ( chvlist->lock != NULL
 */
    Lock_lock(chvlist->lock) ;
    if ( chv != NULL ) {
-      chv->next = chvlist->heads[ilist] ;
-      chvlist->heads[ilist] = chv ;
+      chv->next = SPOOLES_LOAD_ACQUIRE(&chvlist->heads[ilist]) ;
+      SPOOLES_STORE_RELEASE(&chvlist->heads[ilist], chv) ;
    }
    if ( chvlist->counts != NULL ) {
-      chvlist->counts[ilist]-- ;
+      SPOOLES_STORE_RELEASE(&chvlist->counts[ilist],
+                            SPOOLES_LOAD_RELAXED(&chvlist->counts[ilist]) - 1) ;
    }
    chvlist->nlocks++ ;
    Lock_unlock(chvlist->lock) ;
@@ -118,11 +120,12 @@ if ( chvlist->lock != NULL
    ---------------------------------------------
 */
    if ( chv != NULL ) {
-      chv->next = chvlist->heads[ilist] ;
-      chvlist->heads[ilist] = chv ;
+      chv->next = SPOOLES_LOAD_ACQUIRE(&chvlist->heads[ilist]) ;
+      SPOOLES_STORE_RELEASE(&chvlist->heads[ilist], chv) ;
    }
    if ( chvlist->counts != NULL ) {
-      chvlist->counts[ilist]-- ;
+      SPOOLES_STORE_RELEASE(&chvlist->counts[ilist],
+                            SPOOLES_LOAD_RELAXED(&chvlist->counts[ilist]) - 1) ;
    }
 }
 #if MYDEBUG > 0
@@ -163,17 +166,18 @@ if ( chvlist == NULL || ilist < 0 || ilist >= chvlist->nlist ) {
 fprintf(stdout, "\n ChvList %p : get list %d", chvlist, ilist) ;
 fflush(stdout) ;
 #endif
-if ( chvlist->heads[ilist] != NULL ) {
+if ( SPOOLES_LOAD_ACQUIRE(&chvlist->heads[ilist]) != NULL ) {
    if ( chvlist->lock == NULL
      || (chvlist->flags != NULL && chvlist->flags[ilist] == 'N')
-     || (chvlist->counts != NULL && chvlist->counts[ilist] == 0) ) {
+     || (chvlist->counts != NULL
+        && SPOOLES_LOAD_ACQUIRE(&chvlist->counts[ilist]) == 0) ) {
 /*
       ------------------------
       no need to lock the list
       ------------------------
 */
-      chv = chvlist->heads[ilist] ;
-      chvlist->heads[ilist] = NULL ;
+      chv = SPOOLES_LOAD_ACQUIRE(&chvlist->heads[ilist]) ;
+      SPOOLES_STORE_RELAXED(&chvlist->heads[ilist], (Chv *) NULL) ;
    } else {
 /*
       ----------------------------------------------------
@@ -181,8 +185,8 @@ if ( chvlist->heads[ilist] != NULL ) {
       ----------------------------------------------------
 */
       Lock_lock(chvlist->lock) ;
-      chv = chvlist->heads[ilist] ;
-      chvlist->heads[ilist] = NULL ;
+      chv = SPOOLES_LOAD_ACQUIRE(&chvlist->heads[ilist]) ;
+      SPOOLES_STORE_RELAXED(&chvlist->heads[ilist], (Chv *) NULL) ;
       chvlist->nlocks++ ;
       Lock_unlock(chvlist->lock) ;
    }
diff --git a/SubMtxList/src/util.c b/SubMtxList/src/util.c
