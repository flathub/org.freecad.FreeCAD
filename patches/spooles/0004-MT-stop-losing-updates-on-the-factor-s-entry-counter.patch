-         frontmtx->nentL += nent ;
+         SPOOLES_FETCH_ADD_RELAXED(&frontmtx->nentL, nent) ;
          if ( msglvl > 2 ) {
             fprintf(msgFile, "\n\n LNJ matrix") ;
             SubMtx_writeForHumanEye(mtx, msgFile) ;
