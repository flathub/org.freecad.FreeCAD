@@ -137,7 +138,7 @@ if ( pivotsizes != NULL ) {
       SubMtx_writeForHumanEye(mtx, msgFile) ;
       fflush(msgFile) ;
    }
-   frontmtx->nentD += nent ;
+   SPOOLES_FETCH_ADD_RELAXED(&frontmtx->nentD, nent) ;
 } else {
